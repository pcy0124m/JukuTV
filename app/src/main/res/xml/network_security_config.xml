<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 视频源里有不少 http 直链，全部放行；实际请求由原生拦截层转发 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
